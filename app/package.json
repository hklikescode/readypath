{
  "name": "readypath-v2",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "sync": "node scripts/sync-data.js",
    "start": "npm run sync && expo start --dev-client",
    "model": "node scripts/push-model.js",
    "android": "npm run sync && npm run model --silent && expo run:android",
    "test": "npm run sync --silent && tsx --test \"tests/*.test.ts\"",
    "eval": "npm run sync --silent && tsx scripts/eval.ts",
    "typecheck": "npm run sync --silent && tsc --noEmit",
    "web": "npm run sync && expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "0.4.1",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.28",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "57.1.1",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "llama.rn": "0.12.9",
    "moti": "0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-confetti-cannon": "1.5.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
